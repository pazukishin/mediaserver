# MediaServer — plantilla de configuración.
# Copia este fichero a `.env`. El servidor lo carga con
# `node --env-file-if-exists=.env`, así que no hace falta exportar nada a mano.

# --- Red ---------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# --- Biblioteca y datos (montajes de sólo lectura / escritura) ---------------
# Por defecto: /media y /data si existen en el contenedor; si no, ./media y ./data
MEDIA_DIR=./media
DATA_DIR=./data

# --- Sesión y credenciales (OBLIGATORIAS: sin ellas el servidor no arranca) --
MEDIA_USER=media
# Contraseña de acceso. No hay valor por defecto y nunca se registra en logs.
MEDIA_PASSWORD=
# Secreto que firma la cookie de sesión. Mínimo 32 caracteres. Genéralo con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Comportamiento -----------------------------------------------------------
# 1 cuando haya un proxy inverso delante (activa `secure` + trustProxy)
TRUST_PROXY=0
# Ficheros procesados en paralelo durante el escaneo
SCAN_CONCURRENCY=2
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
