{
  "name": "MediaServer",
  "version": "1.2.2",
  "description": "Private self-hosted media server for browsing and playing local audio and video libraries.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "node --test"
  },
  "keywords": ["media-server", "self-hosted", "audio", "video", "docker"],
  "author": "pazukishin",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@vidstack/react": "^1.15.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
